  "acceptance": {
    "fresh_representation_gate": [
      "behavior_repaired aggregate required behavior-pattern recall must be at least 0.85.",
      "behavior_repaired must not have lower behavior-pattern recall than symbol_evidence on any answerable task.",
      "behavior_repaired must preserve explicit unresolved/insufficient force_promote handling without inventing implementation.",
      "All behavior_repaired behavioral envelopes must remain within the preregistered 2200 estimated-token cap.",
      "Continuation must add at most one already-activated source-backed dependency and may not promote AI-inferred graph truth."
    ],
    "blind_downstream_comparative_gate": [
      "An eligible downstream run must be blind to the oracle and source gold.",
      "behavior_repaired required answer-claim recall must exceed symbol_evidence required answer-claim recall.",
      "behavior_repaired answerable-task pass count must be at least symbol_evidence.",
      "behavior_repaired unsupported-trap hits and invalid citation count must be no greater than symbol_evidence.",
      "The missing force_promote control must be answered need_more_context without invented implementation."
    ],
    "absolute_fidelity_guard": [
      "eligible_for_shipping_decision must be true.",
      "required answer-claim recall must be at least 0.90.",
      "at least 6 of 7 answerable tasks must pass all required claims with grounded citations.",
      "unsupported-trap hits must be zero.",
      "invalid or ungrounded citations must be zero.",
      "the missing-identifier control must pass."
    ],
    "default_decision": "P2.4d alone does not change the legacy product default unless an oracle-blind eligible downstream run satisfies the absolute fidelity guard. Representation-only success is insufficient."
  },
  "limitations": [
    "The fixture is synthetic but source-locked before the oracle and evaluator.",
    "Behavior-pattern recall measures evidence availability, not model reasoning quality.",
    "Any answer run produced in an oracle-exposed interactive session is diagnostic only and must set eligible_for_shipping_decision=false.",
    "The deterministic context estimate remains compact-JSON ceil(chars/4), not provider billing tokens.",
    "Learned relevance-provider comparison is deferred to a later checkpoint unless a real configured provider is available without changing this frozen corpus.",
    "S7 remains sealed and unused."
  ]
