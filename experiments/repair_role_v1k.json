    {
      "id": "limit-comparison-repair",
      "description": "Retries continue for one attempt beyond the configured ceiling. Preserve the configured value and change only the boundary comparison so the last permitted attempt remains valid.",
      "challenge_tags": ["opaque_ids", "task_conditioning"],
      "task_conditioning_group": "retry-limit-role-swap",
      "provider_task_id": "retry-limit-comparison",
      "candidates": [
        {
          "id": "region_01",
          "symbol": "limit_value",
          "summary": "Provides the default ceiling consumed by retry decisions.",
          "excerpt": "limit_value = 5",
          "region": {"path": "unit/a.src", "start_line": 8, "end_line": 10},
          "gold": {"semantic_relevance": true, "repair_role": "supporting_context"}
        },
        {
          "id": "region_02",
          "symbol": "decision",
          "summary": "Returns whether another attempt is permitted from the current count and configured ceiling.",
          "excerpt": "return current <= settings.limit_value",
